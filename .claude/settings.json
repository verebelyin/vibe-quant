{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/agents/memory_index.py 2>/dev/null || true"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/agents/memory_index.py 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "python3 scripts/agents/bus.py board brief 2>/dev/null || true"
          }
        ],
        "matcher": ""
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/agents/hooks/bd_notes_guard.py"
          }
        ]
      }
    ]
  }
}
