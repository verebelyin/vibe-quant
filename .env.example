# Copy to .env (gitignored) and fill in real values for your environment.
# Every variable below is read directly via os.getenv(). Unset vars use the
# defaults shown in the inline comments.

# --- Research / Reddit -------------------------------------------------------
# The reddit source reads posts + top comments from the free Arctic Shift API
# (https://arctic-shift.photon-reddit.com) — no key needed. This UA is the
# polite identifier we send.
# Format: '<platform>:<app-id>:<version> (by /u/<your-username>)'
REDDIT_USER_AGENT=vibe-quant-research:0.1 (by /u/your-username)

# Comma-separated subreddits to scrape. Default: algotrading
REDDIT_SUBREDDITS=algotrading,quant,wallstreetbets

# --- Paper trading (Binance) -------------------------------------------------
# Testnet sessions (the default) read ONLY these:
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
# LIVE (real funds) sessions read ONLY these, and additionally need
# confirm_live=true via the API or `--live` on the paper CLI:
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Live execution (Ethereal) -----------------------------------------------
ETHEREAL_PRIVATE_KEY=

# --- Alerts (Telegram) -------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- DSL plugins -------------------------------------------------------------
# Strict mode: any plugin load failure aborts startup (default: lenient).
VQ_PLUGINS_STRICT=
# Extra paths (colon-separated) to scan for indicator plugins.
VQ_PLUGIN_PATH=
# Discovery indicator tail memo: 0 disables the discovery indicator tail memo
# (default: on). Only discovery opens it; screening/validation/paper never do.
VIBE_QUANT_IND_MEMO=
# Per-process estimated cap in MB, default 64; monitor notes.ind_memo
# (evictions > 0 means the cap is too small for the run).
VIBE_QUANT_IND_MEMO_MAX_MB=

# --- Research / Hacker News --------------------------------------------------
# Comma-separated search queries for the keyless Algolia HN API source.
# Default: algorithmic trading,trading strategy,backtest,quant trading,crypto trading
HN_QUERIES=algorithmic trading,trading strategy,backtest,quant trading,crypto trading
