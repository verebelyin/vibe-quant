# Copy to .env (gitignored) and fill in real values for your environment.
# Every variable below is read directly via os.getenv(). Unset vars use the
# defaults shown in the inline comments.

# --- Research / Reddit -------------------------------------------------------
# Reddit killed unauthenticated `.json` access in 2026-05 (see
# docs/reddit-access-research.md); a plain request now 403s. The durable fix is
# OAuth (pending approval). REDDIT_USER_AGENT is still used by both paths.
# Format: '<platform>:<app-id>:<version> (by /u/<your-username>)'
REDDIT_USER_AGENT=vibe-quant-research:0.1 (by /u/your-username)

# Comma-separated subreddits to scrape. Default: algotrading
REDDIT_SUBREDDITS=algotrading,quant,wallstreetbets

# Stopgap until OAuth: glance-style browser-challenge fetch (TLS-fingerprint
# impersonation + JS-challenge solve). ToS-grey, low-volume only; off by
# default. Set to 1/true/yes/on to enable.
REDDIT_USE_CHALLENGE=0

# --- Paper trading (Binance testnet) -----------------------------------------
BINANCE_API_KEY=
BINANCE_API_SECRET=
# CLI fallback names (paper/cli.py reads these if BINANCE_* unset)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# --- Live execution (Ethereal) -----------------------------------------------
ETHEREAL_PRIVATE_KEY=

# --- Alerts (Telegram) -------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- DSL plugins -------------------------------------------------------------
# Strict mode: any plugin load failure aborts startup (default: lenient).
VQ_PLUGINS_STRICT=
# Extra paths (colon-separated) to scan for indicator plugins.
VQ_PLUGIN_PATH=
